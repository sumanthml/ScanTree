{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "strict": true,

    "target": "ESNext",

    "module": "ESNext",

    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "allowSyntheticDefaultImports": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "types": ["react", "react-native"],

    "paths": {
      "@/*": ["./*"]
    }
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}