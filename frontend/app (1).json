
{
  "expo": {
    "name": "ScanTrace",
    "slug": "scantrace",
    "version": "1.0.0",

    "orientation": "portrait",

    "scheme": "scantrace",

    "userInterfaceStyle": "automatic",

    "newArchEnabled": true,

    "web": {
      "bundler": "metro"
    },

    "assetBundlePatterns": ["**/*"],

    "plugins": ["expo-router"],

    "experiments": {
      "typedRoutes": true
    },

    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    }
  }
}